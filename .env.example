# Backend API base URL (src/services/server.js). Defaults to
# http://localhost:5001 if unset.
VITE_API_URL=http://localhost:5001

# ── Observability (Grafana Faro RUM — see src/faro.js) ──
# See ../Decipher-Backend/docs/grafana-observability-plan.md Section 8.
# Both must be set for Faro to actually initialize; either missing = disabled.
VITE_OBSERVABILITY_ENABLED=false
# From Grafana Cloud -> Frontend Observability -> Create app.
# VITE_FARO_URL=https://faro-collector-<region>.grafana.net/collect/<app-key>
# VITE_FARO_APP_NAME=decipher-frontend

# Google sign-in. Public value (it ships in the page); the secret stays backend-only.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
